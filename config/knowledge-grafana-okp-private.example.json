{
  "mcpServers": {
    "sds-knowledge": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${SDS_BRAIN_DIR}/mcp/knowledge/server.py", "--root", "${SDS_BRAIN_DIR}",
        "--customer", "${SDS_CUSTOMER}", "--cluster", "${SDS_CLUSTER}"
      ]
    },
    "sds-grafana": {
      "type": "stdio",
      "command": "python3",
      "args": ["${SDS_BRAIN_DIR}/mcp/grafana/launch.py"]
    },
    "sds-okp": {
      "type": "http",
      "url": "http://127.0.0.1:8000/mcp"
    }
  }
}
